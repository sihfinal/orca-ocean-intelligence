# Blue Orbit / ORCA Environment Configuration
# Copy this file to .env and supply your local or production API credentials.

# LLM Provider API Keys (Set at least one provider for generative reasoning)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434

